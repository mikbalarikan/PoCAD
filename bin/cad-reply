#!/data/data/com.termux/files/usr/bin/python3
# cad-reply PROJECT_DIR "message"   (or message on stdin) -> shows in the cad-chat page
import json, sys, time
from pathlib import Path
p = Path(sys.argv[1]).resolve() / ".chat"; p.mkdir(exist_ok=True)
text = sys.argv[2] if len(sys.argv) > 2 else sys.stdin.read()
with (p / "outbox.jsonl").open("a", encoding="utf-8") as f:
    f.write(json.dumps({"ts": time.time(), "text": text.strip()}, ensure_ascii=False) + "\n")
